:: 03_StatsStylesheet [stylesheet]
#ui-bar {
    background:
        linear-gradient(180deg, rgba(17,17,22,0.94), rgba(10,10,14,0.97)),
        url('files/images/ui/stats_panel_background.png');
    background-size: cover;
    background-blend-mode: overlay;
    border-right: 1px solid var(--border-subtle);
}
#ui-bar-body { padding-top: 0.5rem; }
#story-caption { padding: 0; }

/* Native SugarCube title header (from the StoryTitle / StorySubtitle passages)
   is the single source for the game's wordmark, styled here instead of
   duplicating it inside StoryCaption. */
#title {
    padding: 1.5rem 1.25rem 1.25rem;
    margin-bottom: 0.25rem;
}
#story-banner { display: none; }
#story-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--accent-gold);
    margin: 0 0 0.3rem;
}
#story-author { display: none; }
#story-subtitle {
    font-family: var(--font-ui);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin: 0;
}
#story-title-separator {
    display: block;
    width: 100%;
    height: 1px;
    background: var(--border-subtle);
    border: none;
    margin: 1.25rem 0 0;
}

.stats-sidebar {
    padding: 1.25rem 1.25rem 0.75rem;
    font-family: var(--font-ui);
}

.sidebar-portrait {
    width: 100%;
    max-width: 150px;
    aspect-ratio: 3 / 4;
    margin: 0 auto 1.25rem;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
    background: #101014;
}
.sidebar-portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
.sidebar-portrait.is-missing { display: none; }

.stat-group { margin-bottom: 0.6rem; }

.stat-label {
    display: flex;
    justify-content: space-between;
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 0.25rem;
}
.stat-label .stat-num { color: var(--text-secondary); letter-spacing: 0; }

.stat-bar {
    height: 4px;
    background: #17171d;
    border-radius: 2px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
}

.stat-fill {
    height: 100%;
    border-radius: 2px;
    transition: width 0.6s var(--ease);
}
.stat-fill.identity { background: linear-gradient(90deg, var(--accent-ice), #7fa3c9); }
.stat-fill.marriage { background: linear-gradient(90deg, var(--accent-rose), #c26a7d); }
.stat-fill.submission { background: linear-gradient(90deg, var(--accent-gold), var(--accent-gold-bright)); }
.stat-fill.feminization { background: linear-gradient(90deg, #8b5a9a, #b57fc9); }
.stat-fill.arousal { background: linear-gradient(90deg, #a85a7a, #d187a8); }
.stat-fill.ntr { background: linear-gradient(90deg, #8a4a3a, #c47a5a); }
.stat-fill.victoria { background: linear-gradient(90deg, #4a6a5a, #7aa38f); }
.stat-fill.suspicion { background: linear-gradient(90deg, #6a5a3a, #a38a5a); }

.time-chip {
    margin-top: 1rem;
    padding: 0.7rem 0.85rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
    display: flex;
    justify-content: space-between;
}
.time-chip .time-day { color: var(--accent-gold); }

.objective-box {
    margin-top: 0.6rem;
    padding: 0.7rem 0.85rem;
    background: rgba(196, 163, 90, 0.06);
    border: 1px solid var(--border-gold);
    border-left: 2px solid var(--accent-gold);
    border-radius: 4px;
}
.objective-label {
    font-size: 0.58rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 0.3rem;
}
.objective-text {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--text-primary);
}

#ui-bar-toggle { color: var(--text-dim); }
#ui-bar-toggle:hover { color: var(--accent-gold); }
