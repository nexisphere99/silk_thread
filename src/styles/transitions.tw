:: 06_TransitionsStylesheet [stylesheet]
/* SugarCube outro/passage transition classes */
.passage-out {
    animation: passageOut 0.22s var(--ease) forwards;
}
@keyframes passageOut {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-10px); }
}

/* Title / system screens */
.title-screen {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    animation: passageIn 1s var(--ease);
}

.title-image {
    width: 100%;
    max-width: 520px;
    margin-bottom: 2rem;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
}
.title-image img { width: 100%; display: block; }
.title-image.is-missing { display: none; }
.title-screen.has-title-image .title-text-fallback { display: none; }

.title-wordmark {
    font-family: var(--font-display);
    font-size: 3.4rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--text-primary);
    margin: 0;
}
.title-rule {
    width: 90px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
    margin: 1.1rem auto;
}
.title-subtitle {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 3rem;
}

.title-menu {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 260px;
}
.title-menu a {
    display: block;
    padding: 0.85rem 1rem;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    color: var(--text-secondary) !important;
    text-decoration: none !important;
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
    transition: all var(--speed) var(--ease);
}
.title-menu a:hover {
    color: var(--accent-gold-bright) !important;
    border-color: var(--border-gold);
    background: var(--bg-card);
    letter-spacing: 0.18em;
}
.title-menu a.primary {
    color: var(--accent-gold) !important;
    border-color: var(--border-gold);
}

.title-footer {
    margin-top: 3rem;
    font-family: var(--font-ui);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    text-transform: uppercase;
}

/* Stats summary table (end of release) */
.stats-full table { width: 100%; border-collapse: collapse; margin: 1.25rem 0; font-family: var(--font-ui); font-size: 0.85rem; }
.stats-full th, .stats-full td { text-align: left; padding: 0.5rem 0.25rem; border-bottom: 1px solid var(--border-subtle); }
.stats-full th { color: var(--text-dim); font-weight: 500; text-transform: uppercase; font-size: 0.65rem; letter-spacing: 0.1em; }
.stats-full h3 { font-family: var(--font-display); color: var(--accent-gold); font-size: 1.15rem; margin: 2rem 0 0.5rem; }
.quest-check { color: var(--accent-gold); }
.quest-missed { color: var(--text-dim); }
