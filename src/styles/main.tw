:: 01_MainStylesheet [stylesheet]
@import url('https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap');

:root {
    --bg-primary: #0a0a0e;
    --bg-secondary: #111116;
    --bg-tertiary: #16161c;
    --bg-card: #1a1a22;
    --bg-card-hover: #202029;
    --text-primary: #d9d5cb;
    --text-secondary: #938d80;
    --text-dim: #5c584f;
    --accent-gold: #c4a35a;
    --accent-gold-bright: #e0c070;
    --accent-rose: #9a4a5a;
    --accent-ice: #5a7a9a;
    --border-subtle: #232329;
    --border-gold: rgba(196, 163, 90, 0.4);
    --shadow-deep: 0 20px 60px rgba(0, 0, 0, 0.55);
    --font-body: 'Libre Baskerville', Georgia, 'Times New Roman', serif;
    --font-ui: 'Inter', 'Helvetica Neue', Arial, sans-serif;
    --font-display: 'Cormorant Garamond', 'Libre Baskerville', serif;
    --speed: 0.35s;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

* { box-sizing: border-box; }

html, body {
    background: var(--bg-primary);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 18px;
    line-height: 1.85;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
}

body {
    background-image:
        radial-gradient(ellipse 80% 60% at 50% -10%, rgba(196, 163, 90, 0.05), transparent),
        radial-gradient(ellipse 60% 50% at 100% 100%, rgba(90, 122, 154, 0.04), transparent);
    background-attachment: fixed;
}

*::selection { background: rgba(196, 163, 90, 0.28); color: #fff; }

html::-webkit-scrollbar { width: 10px; height: 10px; }
html::-webkit-scrollbar-track { background: var(--bg-primary); }
html::-webkit-scrollbar-thumb { background: #26262e; border-radius: 6px; border: 2px solid var(--bg-primary); }
html::-webkit-scrollbar-thumb:hover { background: #33333d; }

a { color: var(--accent-gold); }

#story {
    max-width: 700px;
    margin: 0 auto;
    padding: 3.5rem 1.75rem 6rem;
}

.passage { animation: passageIn 0.7s var(--ease); }

@keyframes passageIn {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
}

#story p, #story > div > p { margin: 0 0 1.35em; }
#story em { color: #cabf9e; font-style: italic; }
#story strong { color: var(--accent-gold-bright); font-weight: 700; }

.location-header {
    font-family: var(--font-ui);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-gold);
    opacity: 0.85;
    margin: 0 0 1.75rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 0.6em;
}

.location-header::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent-gold);
    box-shadow: 0 0 8px var(--accent-gold);
    flex-shrink: 0;
}

/* Hero / scene imagery */
.scene-image {
    position: relative;
    margin: -0.25rem 0 1.75rem;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
    background: linear-gradient(160deg, #15151b, #0c0c10);
}

.scene-image img {
    width: 100%;
    height: auto;
    display: block;
    filter: saturate(0.92) contrast(1.03);
}

.scene-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10,10,14,0) 55%, rgba(10,10,14,0.55) 100%);
    pointer-events: none;
}

.scene-image.is-missing { display: none; }

/* Character insets */
.portrait-inset {
    float: right;
    width: 34%;
    max-width: 190px;
    margin: 0.15rem 0 1rem 1.5rem;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
    aspect-ratio: 3 / 4;
    background: #101014;
}
.portrait-inset img { width: 100%; height: 100%; object-fit: cover; display: block; }
.portrait-inset.is-missing { display: none; }
.portrait-caption {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-align: center;
    padding: 0.4rem 0.3rem;
    border-top: 1px solid var(--border-subtle);
}

/* Mood / set-piece images */
.mood-image {
    margin: 1.75rem auto;
    max-width: 420px;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-deep);
}
.mood-image img { width: 100%; display: block; }
.mood-image.is-missing { display: none; }
.mood-image figcaption {
    font-family: var(--font-ui);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-align: center;
    padding: 0.6rem 0.4rem 0;
}

/* Speaker-labeled dialogue blocks, rendered by <<say>> / <<sayself>> */
.npc-dialogue {
    margin: 1.5rem 0;
    padding-left: 1.1rem;
    border-left: 2px solid var(--accent-gold);
}
.npc-dialogue.is-player { border-left-color: var(--accent-ice); }
.npc-name {
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-gold);
    margin-bottom: 0.35rem;
}
.npc-dialogue.is-player .npc-name { color: var(--accent-ice); }
.npc-line {
    font-family: var(--font-body);
    font-style: italic;
    color: var(--text-primary);
    line-height: 1.6;
}
.npc-line em { font-style: normal; }

@media (max-width: 720px) {
    #story { padding: 2rem 1.15rem 5rem; font-size: 17px; }
    .portrait-inset { width: 42%; margin-left: 1rem; }
}
